# ==============================================================================
# AI FINANCE DEALS — ENVIRONMENT CONFIGURATION TEMPLATE
# Production Domain: https://aifinancedeals.com
# Placeholders only. NEVER commit real secrets, tokens, or .env files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE REQUIRED VARIABLES FOR LIVE SUPABASE AUTH & DATABASE
#    Scope in Netlify: Builds + Functions (or All Scopes)
#    Note: Use the API URL (https://<project-ref>.supabase.co), NOT the dashboard URL.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE OPTIONAL CONFIGURATION (Public VITE_* — Site Builds Without These)
#    Scope in Netlify: Builds
# ------------------------------------------------------------------------------
# Canonical public origin (defaults to https://aifinancedeals.com if omitted)
VITE_SITE_URL="https://aifinancedeals.com"

# Google Tag Manager Container ID (optional; consent-gated, format: GTM-XXXXXXX)
VITE_GTM_ID=""

# Google Analytics 4 Measurement ID (optional; consent-gated, format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""

# Google Search Console Verification Token (optional; raw token string)
VITE_GSC_VERIFICATION=""

# Google AdSense Feature Flag (MUST stay "false" until AdSense domain approval)
VITE_ADSENSE_ENABLED="false"

# Google AdSense Publisher ID (optional, format: ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID="ca-pub-7571394117486446"

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE ONLY SECRETS (NEVER PREFIX WITH VITE_!)
#    Scope in Netlify: Functions ONLY (enable "Contains secret values" in Netlify UI;
#    uncheck "Builds" and "Post processing" so keys never enter Vite/client bundles).
# ------------------------------------------------------------------------------
# Server-side Supabase Project API URL (used by netlify/functions/*)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Service Role Key (bypasses RLS — trusted Netlify Functions ONLY)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-server-only"

# Direct PostgreSQL URL (optional; offline CLI migrations / RLS test suite ONLY)
# Never referenced by frontend code or Netlify runtime functions.
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"
